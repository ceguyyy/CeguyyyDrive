{
  "name": "ceguyyydrive-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CeguyyyDrive Cloud Storage System Monorepo",
  "scripts": {
    "dev": "npx -y concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "migrate": "npm --prefix backend run migrate",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:audit": "docker-compose exec backend npm audit && docker-compose exec nginx npm audit",
    "docker:outdated": "docker-compose exec backend npm outdated"
  },
  "devDependencies": {
    "@upstash/context7-mcp": "^1.0.0"
  }
}
